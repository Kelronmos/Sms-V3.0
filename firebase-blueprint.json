{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Basic information about a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "student_id": { "type": "string", "description": "School-specific ID" },
        "name": { "type": "string", "description": "Full name" },
        "class_id": { "type": "string", "description": "Class identifier" },
        "email": { "type": "string", "format": "email" },
        "photo_url": { "type": "string" },
        "behavior_score": { "type": "number" },
        "academic_average": { "type": "number" }
      },
      "required": ["id", "student_id", "name"]
    },
    "Metric": {
      "title": "Metric",
      "description": "Daily wellbeing and engagement metrics",
      "type": "object",
      "properties": {
        "student_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "mood_score": { "type": "number", "description": "1-5 scale" },
        "stress_score": { "type": "number", "description": "1-5 scale" },
        "sleep_hours": { "type": "number" },
        "engagement_hours": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["student_id", "date", "mood_score"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Academic tasks and deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "student_id": { "type": "string" },
        "title": { "type": "string" },
        "due_date": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["pending", "submitted", "graded"] },
        "subject": { "type": "string" }
      },
      "required": ["student_id", "title", "due_date"]
    },
    "Communication": {
      "title": "Communication",
      "description": "Messages between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "receiver_id": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "alert"] }
      },
      "required": ["sender_id", "receiver_id", "content", "timestamp"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "student_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] }
      },
      "required": ["student_id", "date", "status"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Safety or behavior incident report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "student_id": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "required": ["student_id", "type", "severity", "timestamp"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Request for administrative approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterId": { "type": "string" },
        "requesterRole": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["requesterId", "requesterRole", "status", "timestamp"]
    },
    "District": {
      "title": "District",
      "description": "Educational district information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "StudentUpdate": {
      "title": "StudentUpdate",
      "description": "Teacher's qualitative update for a student",
      "type": "object",
      "properties": {
        "student_id": { "type": "string" },
        "teacher_id": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["student_id", "teacher_id", "content", "timestamp"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User's dashboard layout preferences",
      "type": "object",
      "properties": {
        "order": { "type": "array", "items": { "type": "string" } },
        "visibleWidgets": { "type": "object" },
        "isAutoLayout": { "type": "boolean" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct message between students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "sender_name": { "type": "string" },
        "receiver_id": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["sender_id", "sender_name", "receiver_id", "content", "timestamp"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Connection between students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "friend_id": { "type": "string" },
        "friend_name": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "friend_id", "friend_name", "status", "timestamp"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student profiles"
    },
    "/metrics/{metricId}": {
      "schema": "Metric",
      "description": "Wellbeing metrics"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Student assignments"
    },
    "/communications/{commId}": {
      "schema": "Communication",
      "description": "Chat messages"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    },
    "/incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Incident reports"
    },
    "/approvals/{approvalId}": {
      "schema": "Approval",
      "description": "Approval requests"
    },
    "/districts/{districtId}": {
      "schema": "District",
      "description": "District information"
    },
    "/student_updates/{updateId}": {
      "schema": "StudentUpdate",
      "description": "Teacher updates for students"
    },
    "/user_preferences/{prefId}": {
      "schema": "UserPreference",
      "description": "User dashboard layout preferences"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct messages between students"
    },
    "/friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Student connections"
    }
  }
}
